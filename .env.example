# 模型（P1 用 embedding/reranker，P2 才需要 LLM key）
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# 向量库（Milvus Lite 本地文件）
MILVUS_URI=./data/milvus.db
COLLECTION_NAME=doc_agent

# 入库目录（/ingest 只允许读该目录内文件，防路径穿越）
DOCS_DIR=./data

# 数据分析数据源（DuckDB 只读查询的 CSV）
SALES_CSV=./data/sales.csv

# 检索
TOP_K=6
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# LLM 可靠性（超时秒 / 重试次数 / 退避基数）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=1.0

# Agent 改写语义漂移门控（改写后与原文相似度低于该值则弃用改写）
REWRITE_MIN_SIMILARITY=0.5

# 短期记忆：memory = 进程内（单机）；redis = 多实例共享（生产）
MEMORY_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
MEMORY_TTL=3600
